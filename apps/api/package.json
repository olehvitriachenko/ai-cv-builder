{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "pnpm run prisma:generate && nest build",
    "dev": "pnpm run start:dev",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "pnpm run prisma:generate && nest start",
    "start:dev": "pnpm run prisma:generate && nest start --watch",
    "start:debug": "pnpm run prisma:generate && nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "pnpm run prisma:generate && oxlint --type-aware src/ test/",
    "test": "pnpm run prisma:generate && vitest run",
    "test:watch": "pnpm run prisma:generate && vitest",
    "test:cov": "pnpm run prisma:generate && vitest run --coverage",
    "test:debug": "pnpm run prisma:generate && vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "pnpm run prisma:generate && vitest run --config ./vitest.config.e2e.ts",
    "test:smoke": "vitest run --config ./vitest.config.smoke.ts",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config prisma7.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "typecheck": "pnpm run prisma:generate && tsc --noEmit"
  },
  "dependencies": {
    "@ai-cv-builder/skill-catalogue": "workspace:*",
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.1.2",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-pdf/renderer": "^4.9.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^18.0.5",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
