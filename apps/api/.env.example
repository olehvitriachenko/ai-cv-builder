# Copy to .env and adjust. Do not commit real secrets.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_cv_builder?schema=public"
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

# AI generation. The key is optional: without it the app starts and generations end FAILED
# (PROVIDER_NOT_CONFIGURED). Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_TIMEOUT_MS=120000
GENERATION_TIMEOUT_MS=300000
GENERATION_CONCURRENCY=2
# Set to false only in tests (disables the runner timers, startup sweep and post-create kick).
GENERATION_AUTORUN=true
